# ==================================================================================
# Environment Variables Configuration
# Sao chép file này và điền các giá trị của bạn
#
# Sử dụng trong:
# - backend/docker-compose.yml
# - frontend/docker-compose.yml
# - infra/docker-compose.yml
# ==================================================================================

# ==================================================================================
# DATABASE CONFIGURATION
# ==================================================================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_change_me

# MongoDB
MONGO_USER=mongodb
MONGO_PASSWORD=mongo_password_change_me

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# ==================================================================================
# SERVICE CONFIGURATION
# ==================================================================================

# Eureka Discovery Service
EUREKA_URI=http://discovery-service:8761/eureka
EUREKA_USER=eureka
EUREKA_PASSWORD=eureka_password

# Axon Server
AXON_SERVER=axonserver:8124
AXON_SERVER_PORT=8024

# Kafka
KAFKA_SERVER=kafka:29092
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ==================================================================================
# DATABASE NAMES
# ==================================================================================

DB_HOST=postgres
DB_PORT=5432
DB_NAME_IDENTITY=identity_service_db
DB_NAME_PRODUCT=product_service_db
DB_NAME_ORDER=order_service_db
DB_NAME_PAYMENT=payment_service_db
DB_NAME_WORKER=worker_service_db

MONGO_HOST=mongo
MONGO_PORT=27017
PRODUCT_DB_NAME=product_service

# ==================================================================================
# MINIO (S3-compatible Object Storage) CONFIGURATION
# ==================================================================================

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_URL=http://minio:9000
MINIO_BUCKET=flashsale

# ==================================================================================
# FRONTEND CONFIGURATION
# ==================================================================================

NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/api/v1

# ==================================================================================
# LOGGING CONFIGURATION
# ==================================================================================

LOG_LEVEL=INFO
SPRING_PROFILES_ACTIVE=docker

# ==================================================================================
# ELASTICSEARCH CONFIGURATION
# ==================================================================================

ELASTIC_URI=http://elasticsearch:9200
ELASTIC_USER=elastic
ELASTIC_PASSWORD=elastic_password_change_me

# ==================================================================================
# SECURITY CONFIGURATION
# ==================================================================================

JWT_SECRET=your_jwt_secret_key_change_me_in_production
JWT_EXPIRATION=86400000

# ==================================================================================
# DOCKER BUILD CONFIGURATION
# ==================================================================================

DOCKER_REGISTRY=docker.io
DOCKER_REPOSITORY=your_repository

# ==================================================================================
# Development/Test Configuration
# ==================================================================================

# Set to 'false' untuk production
DEBUG_MODE=false
DEV_MODE=true

