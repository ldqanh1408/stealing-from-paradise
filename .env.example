# ============================================================
# FLASH SALE E-COMMERCE — PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================
# ⚠️  CẢNH BÁO: File này chứa secrets. KHÔNG BAO GIỜ commit lên GitHub public.
#     Copy vào .env rồi điền giá trị thực.
#
# QUICK START:
#   cp .env.example .env
#   # Điền các giá trị production vào .env
#   docker-compose -f docker-compose.yml -f docker-compose-backend.yml up --build -d
#
# STRUCTURE:
#   Section [A] — Version pinning
#   Section [B] — Spring profile (DEV vs PROD)
#   Section [C] — Host ports
#   Section [D] — Secrets & credentials  ← ĐIỀN TRƯỚC PRODUCTION
#   Section [E] — Database names
#   Section [F] — Infrastructure routing (service names trong Docker network)
#   Section [G] — 3rd-party integrations  ← ĐIỀN TRƯỚC PRODUCTION
#   Section [H] — JVM / resource tuning
#   Section [I] — Frontend API configuration
#
# DEV vs PROD:
#   Dev:   SPRING_PROFILES_ACTIVE=dev    (seed data ON, debug logs)
#   Prod:  SPRING_PROFILES_ACTIVE=prod   (seed data OFF, INFO logs)
#   Server: docker-compose.prod-pulled.yml overrides to SPRING_PROFILES_ACTIVE=prod
# ============================================================

# ---- [A] VERSION PINNING ----
COMPOSE_PROJECT_NAME=flashsale
TZ=Asia/Ho_Chi_Minh
POSTGRES_VER=15.4-alpine
MONGO_VER=6.0.8
REDIS_VER=7.2.1-alpine
KAFKA_VER=7.4.0
ELASTIC_VER=8.10.2
AXON_VER=latest

# ---- [B] SPRING PROFILE ----
#   dev   — Docker dev mode: seed data ON, debug logs
#   prod  — Production: seed data OFF, INFO logs
#   (Production on server uses docker-compose.prod-pulled.yml which overrides this)
SPRING_PROFILES_ACTIVE=dev

# ---- [C] HOST PORTS ----
# Port trên máy host (localhost). Đổi ở đây nếu port bị trùng.
PORT_DISCOVERY=8761
PORT_GATEWAY=8080
PORT_IDENTITY=8081
PORT_PAYMENT=8082
PORT_ORDER=8083
PORT_REFUND=8094
PORT_PRODUCT=8090
PORT_FLASHSALE=8085
PORT_SEARCH=8091
PORT_NOTIFICATION=8092
PORT_WORKER=8086
PORT_ELASTIC=9200
PORT_KAFKA_CONNECT=18083
PORT_MINIO=9000
PORT_MINIO_CONSOLE=9001
PORT_CUSTOMER=3000
PORT_SELLER=3001
PORT_ADMIN=3002
PORT_AXON_GUI=8024
PORT_AXON_GRPC=8124

# ---- [D] SECRETS & CREDENTIALS ----
# ⚠️  THAY ĐỔI TẤT CẢ TRƯỚC PRODUCTION

# JWT
JWT_SECRET=CHANGE_ME_generate_a_random_256bit_base64_string
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# MongoDB
MONGO_INITDB_ROOT_USERNAME=fs_mongo_admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_strong_password_here

# Redis
REDIS_PASSWORD=CHANGE_ME_strong_password_here

# MinIO (S3-compatible storage)
MINIO_ACCESS_KEY=CHANGE_ME_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key

# ---- [E] DATABASE NAMES ----
DB_NAME=flashsale_platform
DB_NAME_PRODUCT=fs_product
DB_NAME_NOTIFICATION=fs_notification

# ---- [F] INFRASTRUCTURE ROUTING ----
# Docker service names. Chỉ đổi nếu đổi tên service trong docker-compose.
DB_HOST=postgres
MONGO_HOST=mongo
REDIS_HOST=redis
KAFKA_SERVER=kafka:9092
AXON_SERVER=axonserver:8124
ELASTIC_URI=http://elasticsearch:9200
MINIO_URL=http://minio:9000
EUREKA_URI=http://discovery-service:8761/eureka/

# ---- [G] 3RD-PARTY INTEGRATIONS ----
# ⚠️  ĐIỀN KEY THỰC TRƯỚC PRODUCTION

# Stripe
# Publishable keys (dùng ở frontend — safe để public)
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY

# Secret key (CHỈ dùng phía backend/payment-service)
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY

# Stripe Webhook Secrets
# DEV: Từ `stripe listen --print-secret`
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_DEV_WEBHOOK_SECRET

# PROD: Từ Stripe Dashboard > Developers > Webhooks
# Đặt trong GitHub Secrets (STRIPE_WEBHOOK_SECRET_PROD)
STRIPE_WEBHOOK_SECRET_PROD=whsec_REPLACE_WITH_PROD_WEBHOOK_SECRET

STRIPE_PLATFORM_FEE_PERCENTAGE=5.0

# Email (SendGrid)
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=REPLACE_WITH_SENDGRID_API_KEY
MAIL_FROM=no-reply@yourdomain.com

# VNPay (optional — nếu dùng VNPay thay vì Stripe)
VNPAY_TMN_CODE=REPLACE_WITH_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=REPLACE_WITH_VNPAY_HASH_SECRET
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://your-domain.com/api/v1/payment/vnpay-return

# ---- [H] RESOURCE TUNING ----
ES_JAVA_OPTS=-Xms512m -Xmx512m
JVM_OPTS_GATEWAY=-Xms512m -Xmx512m -XX:+UseG1GC
JVM_OPTS_IDENTITY=-Xms256m -Xmx512m -XX:+UseG1GC
JVM_OPTS_PAYMENT=-Xms512m -Xmx512m -XX:+UseG1GC --enable-native-access=ALL-UNNAMED
JVM_OPTS_ORDER=-Xms512m -Xmx1g -XX:+UseG1GC --enable-native-access=ALL-UNNAMED
JVM_OPTS_FLASHSALE=-Xms1g -Xmx1g -XX:+UseG1GC --enable-native-access=ALL-UNNAMED
JVM_OPTS_PRODUCT=-Xms512m -Xmx1g -XX:+UseG1GC
JVM_OPTS_SEARCH=-Xms512m -Xmx1g -XX:+UseG1GC
JVM_OPTS_NOTIFICATION=-Xms256m -Xmx512m -XX:+UseG1GC
JVM_OPTS_REFUND=-Xms256m -Xmx512m -XX:+UseG1GC
JVM_OPTS_WORKER=-Xms512m -Xmx1g -XX:+UseG1GC
JVM_OPTS_COMMON=-Xms256m -Xmx512m -XX:+UseG1GC

# ---- [I] FRONTEND ----
# Browser calls /api/v1/xxx → nginx reverse-proxy/per-app forwards as-is
# → gateway matches /api/v1/** routes → stripPrefix(1) → microservice.
#
# IMPORTANT: dùng literal values (KHÔNG dùng ${VAR:-default} shell syntax).
# Lý do: docker-compose `env_file:` đọc file LITERAL (không shell-expand).
# Để override, set env var TRƯỚC docker-compose:
#   VITE_API_URL=https://prod.example.com/api/v1 docker-compose up
VITE_API_URL=/api/v1
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_WS_URL=/ws/user
