# Production image — builds JAR inside the container (multi-stage)
# Context: ./backend
FROM maven:3.9-eclipse-temurin-25-alpine AS builder

WORKDIR /app

COPY pom.xml .
COPY common-lib/pom.xml common-lib/
COPY api-gateway/pom.xml api-gateway/
RUN mvn dependency:go-offline -pl api-gateway -am -q

COPY api-gateway/src api-gateway/src
RUN mvn package -pl api-gateway -DskipTests -q

FROM eclipse-temurin:25-jre-alpine AS runtime

WORKDIR /app

COPY --from=builder /app/api-gateway/target/api-gateway-*.jar app.jar

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
