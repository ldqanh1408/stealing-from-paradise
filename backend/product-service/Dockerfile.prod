# Production image — builds JAR inside the container (multi-stage)
# Context: ./backend
FROM maven:3.9-eclipse-temurin-25-alpine AS builder

WORKDIR /app

COPY pom.xml .
COPY common-lib/pom.xml common-lib/
COPY product-service/pom.xml product-service/
RUN mvn dependency:go-offline -pl product-service -am -q

COPY product-service/src product-service/src
RUN mvn package -pl product-service -DskipTests -q

FROM eclipse-temurin:25-jre-alpine AS runtime

WORKDIR /app

COPY --from=builder /app/product-service/target/product-service-*.jar app.jar

EXPOSE 8090
ENTRYPOINT ["java", "-jar", "app.jar"]
