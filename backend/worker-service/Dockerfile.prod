# Production image — builds JAR inside the container (multi-stage)
# Context: ./backend
FROM maven:3.9-eclipse-temurin-25-alpine AS builder

WORKDIR /app

COPY pom.xml .
COPY common-lib/pom.xml common-lib/
COPY worker-service/pom.xml worker-service/
RUN mvn dependency:go-offline -pl worker-service -am -q

COPY worker-service/src worker-service/src
RUN mvn package -pl worker-service -DskipTests -q

FROM eclipse-temurin:25-jre-alpine AS runtime

WORKDIR /app

COPY --from=builder /app/worker-service/target/worker-service-*.jar app.jar

EXPOSE 8086
ENTRYPOINT ["java", "-jar", "app.jar"]
