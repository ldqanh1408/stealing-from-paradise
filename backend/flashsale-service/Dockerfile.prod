# Production image — builds JAR inside the container (multi-stage)
# Context: ./backend
FROM maven:3.9-eclipse-temurin-25-alpine AS builder

WORKDIR /app

COPY pom.xml .
COPY common-lib/ common-lib/
COPY discovery-service/ discovery-service/
COPY api-gateway/ api-gateway/
COPY search-service/ search-service/
COPY worker-service/ worker-service/
COPY notification-service/ notification-service/
COPY identity-service/ identity-service/
COPY product-service/ product-service/
COPY order-service/ order-service/
COPY payment-service/ payment-service/
COPY flashsale-service/ flashsale-service/
RUN mvn dependency:go-offline -pl flashsale-service -am -q

RUN mvn install -pl flashsale-service -am -DskipTests -q

FROM eclipse-temurin:25-jre-alpine AS runtime

WORKDIR /app

COPY --from=builder /app/flashsale-service/target/flashsale-service-*.jar app.jar

EXPOSE 8085
ENTRYPOINT ["java", "-jar", "app.jar"]
