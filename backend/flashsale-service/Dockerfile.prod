# Production image — builds JAR inside the container (multi-stage)
# Context: ./backend
FROM maven:3.9-eclipse-temurin-25-alpine AS builder

WORKDIR /app

COPY pom.xml .
COPY common-lib/pom.xml common-lib/
COPY flashsale-service/pom.xml flashsale-service/
RUN mvn dependency:go-offline -pl flashsale-service -am -q

COPY flashsale-service/src flashsale-service/src
RUN mvn package -pl flashsale-service -DskipTests -q

FROM eclipse-temurin:25-jre-alpine AS runtime

WORKDIR /app

COPY --from=builder /app/flashsale-service/target/flashsale-service-*.jar app.jar

EXPOSE 8085
ENTRYPOINT ["java", "-jar", "app.jar"]
