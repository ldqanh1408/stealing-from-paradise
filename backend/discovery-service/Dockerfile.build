# ============================================================
# Build from source — use this for Render deployment
# The Dockerfile.prod copies pre-built JARs (for GitHub Actions).
# This one builds the JAR inside the container (for Render).
# ============================================================
FROM eclipse-temurin:25-jdk-alpine AS builder
WORKDIR /build

# Copy Maven wrapper and pom from parent
COPY mvnw ./
COPY mvnw.cmd ./
COPY pom.xml ../

# Build all modules first (downloads deps)
RUN chmod +x mvnw && ./mvnw dependency:go-offline -B

# Copy source and build JAR
COPY src ./src
COPY ../common-lib/src ../common-lib/src
COPY pom.xml ../pom.xml

RUN ./mvnw package -DskipTests -B -pl . -am

FROM eclipse-temurin:25-jre-alpine
WORKDIR /app

COPY --from=builder /build/target/discovery-service-*.jar app.jar

RUN addgroup -S spring && adduser -S spring -G spring
USER spring:spring

EXPOSE 8761

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=5 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8761/actuator/health || exit 1

ENTRYPOINT ["java", "-Djava.security.egd=file:/dev/./urandom", "-jar", "/app/app.jar"]
