# Production image — builds JAR inside the container (multi-stage)
# Context: ./backend
FROM maven:3.9-eclipse-temurin-25-alpine AS builder

WORKDIR /app

COPY pom.xml .
COPY common-lib/pom.xml common-lib/
COPY discovery-service/pom.xml discovery-service/
RUN mvn dependency:go-offline -pl discovery-service -am -q

COPY discovery-service/src discovery-service/src
RUN mvn package -pl discovery-service -DskipTests -q

FROM eclipse-temurin:25-jre-alpine AS runtime

WORKDIR /app

COPY --from=builder /app/discovery-service/target/discovery-service-*.jar app.jar

EXPOSE 8761
ENTRYPOINT ["java", "-jar", "app.jar"]
