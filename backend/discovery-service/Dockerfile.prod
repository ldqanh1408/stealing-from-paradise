# Multi-stage: build JAR inside container, use slim JRE image
# Context: ./backend
FROM maven:3.9-eclipse-temurin-25-alpine AS builder

WORKDIR /app

# Copy only what's needed for this service
COPY pom.xml .
COPY common-lib/ common-lib/
COPY discovery-service/ discovery-service/

# Build only this service + deps
RUN mvn install -pl discovery-service -am -DskipTests -q

FROM eclipse-temurin:25-jre-alpine

WORKDIR /app
COPY --from=builder /app/discovery-service/target/discovery-service-*.jar app.jar

EXPOSE 8761
ENTRYPOINT ["java", "-jar", "app.jar"]
