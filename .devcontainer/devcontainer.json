{
  "name": "Stealing From Paradise - Java 25 + React + Docker",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      "MAVEN_VERSION": "3.9.6"
    }
  },

  "containerEnv": {
    "JAVA_HOME": "/opt/java/openjdk",
    "MAVEN_HOME": "/usr/share/maven",
    "MAVEN_OPTS": "-Xmx2048m -XX:+UseG1GC",
    "POSTGRES_USER": "flashsale",
    "POSTGRES_PASSWORD": "devpassword123",
    "POSTGRES_DB": "flashsale",
    "MONGO_INITDB_ROOT_USERNAME": "admin",
    "MONGO_INITDB_ROOT_PASSWORD": "devpassword123",
    "REDIS_PASSWORD": "devpassword123",
    "VITE_API_URL": "http://localhost:8080",
    "SPRING_PROFILES_ACTIVE": "dev",
    "EUREKA_URI": "http://localhost:8761/eureka/",
    "KAFKA_SERVER": "localhost:9092",
    "AXON_SERVER": "localhost:8124",
    "ELASTIC_URI": "http://localhost:9200"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.java",
        "vscjava.vscode-maven",
        "vscjava.vscode-spring-boot",
        "vscjava.vscode-spring-initializr",
        "pivotal.vscode-boot-dev-pack",
        "vmware.vscode-spring-cloud",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "ms-vscode.vscode-typescript-next",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "eamodio.gitlens",
        "ms-vscode-remote.remote-containers",
        "mongodb.mongodb-vscode",
        "redhat.vscode-yaml",
        "postman.postman-for-vscode",
        "humao.rest-client",
        "ms-vscode.makefile-tools",
        "ms-vscode.hexdump",
        "ms-vscode.powershell"
      ],
      "settings": {
        "java.home": "/opt/java/openjdk",
        "java.server.launchMode": "Standard",
        "java.configuration.updateBuildConfiguration": "automatic",
        "java.configuration.runtimes": [
          {
            "name": "JavaSE-25",
            "path": "/opt/java/openjdk",
            "default": true
          }
        ],
        "maven.executable.path": "/usr/share/maven/bin/mvn",
        "maven.terminal.useJavaHome": true,
        "maven.terminal.customEnv": [
          {
            "name": "JAVA_HOME",
            "value": "/opt/java/openjdk"
          },
          {
            "name": "MAVEN_HOME",
            "value": "/usr/share/maven"
          }
        ],
        "[java]": {
          "editor.defaultFormatter": "redhat.java",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": true
          }
        },
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.formatOnSave": true
        },
        "editor.rulers": [80, 120],
        "files.watcherExclude": {
          "**/target": true,
          "**/node_modules": true,
          "**/.git": true,
          "**/.gradle": true
        },
        "search.exclude": {
          "**/target": true,
          "**/node_modules": true,
          "**/.git": true
        },
        "git.ignoreLimitWarning": true
      }
    }
  },

  "forwardPorts": [
    3000, 3001, 3002,
    8080, 8761, 8081, 8082, 8083, 8085, 8088, 8089, 8090, 8091, 8092,
    5432, 27017, 6379, 9200, 9000, 9001, 8124, 9092, 2181
  ],

  "portsAttributes": {
    "3000": {"label": "Customer App", "onAutoForward": "notify"},
    "3001": {"label": "Seller App", "onAutoForward": "notify"},
    "3002": {"label": "Admin App", "onAutoForward": "notify"},
    "8080": {"label": "API Gateway", "onAutoForward": "notify"},
    "8761": {"label": "Service Discovery", "onAutoForward": "notify"},
    "8088": {"label": "Order Service", "onAutoForward": "silent"},
    "8089": {"label": "Payment Service", "onAutoForward": "silent"},
    "8090": {"label": "Product Service", "onAutoForward": "silent"},
    "8091": {"label": "Search Service", "onAutoForward": "silent"},
    "5432": {"label": "PostgreSQL", "onAutoForward": "silent"},
    "27017": {"label": "MongoDB", "onAutoForward": "silent"},
    "6379": {"label": "Redis", "onAutoForward": "silent"},
    "9200": {"label": "Elasticsearch", "onAutoForward": "silent"},
    "9000": {"label": "MinIO API", "onAutoForward": "silent"},
    "9001": {"label": "MinIO Console", "onAutoForward": "silent"},
    "8124": {"label": "Axon Server", "onAutoForward": "silent"},
    "9092": {"label": "Kafka", "onAutoForward": "silent"},
    "2181": {"label": "Zookeeper", "onAutoForward": "silent"}
  },

  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.m2,target=/home/vscode/.m2,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.npm,target=/home/vscode/.npm,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.gradle,target=/home/vscode/.gradle,type=bind",
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "onCreateCommand": "bash .devcontainer/on-create.sh",

  "remoteUser": "vscode",
  "updateRemoteUserUID": false,

  "runArgs": [
    "--network", "host",
    "-e", "DOCKER_HOST=unix:///var/run/docker.sock"
  ]
}