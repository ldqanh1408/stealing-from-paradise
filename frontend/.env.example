# ============================================================
# FLASH SALE FRONTEND — .env.example
# ============================================================
# Copy this to .env and adjust values for your environment.
#
# HOW IT WORKS:
#   The docker-compose reads its own .env in the same directory.
#   This file only needs overrides specific to frontend-only runs.
#
# Quick start:
#   cp .env.example .env
#   docker-compose -f docker-compose.yml up --build
# ============================================================

# Backend connection
# VITE_API_URL=http://localhost:8080/api/v1

# Backend mode: mock (default, no backend needed) | real (connect to backend)
VITE_BACKEND_MODE=mock

# Frontend ports
# PORT_CUSTOMER=3000
# PORT_SELLER=3001
# PORT_ADMIN=3002
# PORT_GATEWAY=8080
