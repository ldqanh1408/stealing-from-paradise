# ============================================================
# FLASH SALE FRONTEND — .env.example (Template)
# ============================================================
# Copy this to .env:
#   cp .env.example .env
#
# For full-stack development, the ROOT docker-compose uses ../.env instead.
# This file is only needed when running frontend Docker-compose standalone.
#
# See .env.local for detailed explanation of each variable.
# ============================================================

# ── Backend connection ────────────────────────────────────────
# Relative path (works with reverse-proxy in production)
VITE_API_URL=/api/v1

# ── Backend mode ──────────────────────────────────────────────
#   mock  — use mock data (no backend needed, default)
#   real  — connect to real backend via VITE_API_URL
VITE_BACKEND_MODE=mock

# ── Frontend ports ────────────────────────────────────────────
PORT_CUSTOMER=3000
PORT_SELLER=3001
PORT_ADMIN=3002
PORT_GATEWAY=8080
